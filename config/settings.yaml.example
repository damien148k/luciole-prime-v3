embedding:
  model: BAAI/bge-m3
  device: auto
  batch_size: 32

retrieval:
  bm25_top_k: 40
  dense_top_k: 40
  fusion_top_k: 30
  bm25_weight: 0.45
  dense_weight: 0.55
  rerank_top_n: 15

reranker:
  model: BAAI/bge-reranker-v2-m3
  device: auto
  batch_size: 32

# ─────────────────────────────────────────────────────────────────────────────
# LLM — TensorRT-LLM 1.2 backend PyTorch (Qwen3-30B-A3B-Instruct-2507 NVFP4)
# Le nom "qwen3-30b-a3b-instruct" DOIT correspondre à SERVED_MODEL_NAME du
# service tensorrt-llm (docker-compose.gx10.yml). On sert le checkpoint NVFP4 direct.
# ─────────────────────────────────────────────────────────────────────────────
llm:
  provider: tensorrt-llm
  model: qwen3-30b-a3b-instruct
  base_url: http://tensorrt-llm:8000
  # Chemin d'appel HTTP. "openai" = endpoint compatible /v1/chat/completions
  # (TRT-LLM, LM Studio, Ollama le servent aussi). "ollama" = API native
  # /api/chat d'Ollama — le seul chemin qui transmet num_ctx a la requete.
  api_format: openai
  # Determinisme. temperature 0 et seed fixe sont ce qui rend une campagne
  # comparable a la suivante. Mesure du 6 aout 2026, deux passages du meme
  # bras sur les memes vingt remarques : dix-neuf reponses identiques au
  # caractere sur vingt, zero verdict change. Avant ces deux reglages, le
  # meme protocole donnait sept reponses identiques sur vingt, ce qui
  # interdisait de conclure sur un ecart d'un ou deux cas.
  # llm.py lit temperature avec 0.0 pour defaut et seed avec 42, mais un
  # settings.yaml qui porte une autre valeur l'emporte : d'ou ces deux
  # lignes explicites.
  temperature: 0
  seed: 42
  max_tokens: 4096
  # num_ctx non utilisé par TRT-LLM (context window fixée à la compilation : 32768 tokens)
  num_ctx: 32768
  timeout: 300
  # ───────────────────────────────────────────────────────────────────────────
  # Backends alternatifs (tous OpenAI-compatibles via le contrat LLM_URL) :
  #
  # Ollama (x86/AMD, mono-instance) :
  #   provider: ollama
  #   model: qwen2.5:14b-instruct-q4_K_M
  #   base_url: http://ollama:11434
  #   api_format: ollama   # transmet num_ctx a chaque requete (API native)
  #   num_ctx: 32768       # fenêtre reelle; sans api_format: ollama elle
  #                        # reste celle du serveur (defaut 2048/4096, ou
  #                        # OLLAMA_CONTEXT_LENGTH) — verifier avec
  #                        # evaluation/sonde_contexte.py
  #   timeout: 1800
  #
  # LM Studio (poste de dev / local) :
  #   provider: lmstudio
  #   model: qwen2.5-14b-instruct
  #   base_url: http://host.docker.internal:1234/v1
  #   timeout: 1800
  # ───────────────────────────────────────────────────────────────────────────

agent:
  port: 8500
  cache_ttl: 0
  default_detail_level: standard
  # Affiche page_start / page_end dans les metadonnees observees par le
  # planificateur. Desactive par defaut : l'activer modifie ce que le
  # modele lit et biaise donc toute comparaison A/B. La variable
  # d'environnement AGENT_OBSERVATION_PAGES a priorite sur cette cle.
  observation_pages: false

chunking:
  chunk_size: 800
  chunk_overlap: 100
  strategy: sentence
  include_file_context: true
  adaptive: true

chunking_strategies:
  pdf:
    strategy: sentence
    chunk_size: 512
    chunk_overlap: 50
  docx:
    strategy: paragraph
    chunk_size: 600
    chunk_overlap: 80
  xlsx:
    strategy: row_group
    rows_per_chunk: 20
    include_header: true
  pptx:
    strategy: slide
    chunk_size: 800
    chunk_overlap: 0
  msg:
    strategy: email
    chunk_size: 800
    chunk_overlap: 0
  txt:
    strategy: sentence
    chunk_size: 400
    chunk_overlap: 50

excel:
  max_rows_per_chunk: 50
  overlap_rows: 5
  enable_sql_storage: true
  sqlite_path: /app/data/excel_data.db
  include_stats: true
  detect_key_columns: true

pdf:
  enable_ocr: false
  markdown_timeout: 0
  markdown_timeout_per_page: 2.0
  ocr_dpi: 300
  max_drawings_per_page: 500
  # Garde-fou de rendement : si le markdown extrait d'une page fait moins de
  # 50 % du texte brut de la meme page (get_text), la page est re-extraite en
  # texte simple. Protege contre les pertes silencieuses de pymupdf4llm sur
  # les pages a mise en page complexe. Mettre 0 pour desactiver.
  min_yield_ratio: 0.5

opensearch:
  host: localhost
  port: 9200
  index_name: documents

qdrant:
  host: localhost
  port: 6333
  collection_name: documents
  distance: cosine

api:
  host: 0.0.0.0
  port: 8000
  reload: false

logging:
  level: INFO
  format: '%(asctime)s - %(name)s - %(levelname)s - %(message)s'
  file: data/logs/rag_system.log

feedback:
  enabled: true
  key_users:
    - damien

ragas:
  enabled: true
  use_local_llm: true
  # eval_model : nom du modele tel que servi par le backend LLM actif
  # (SERVED_MODEL_NAME cote tensorrt-llm, ou tag visible dans `ollama list`
  # pour le profil Ollama, ex. qwen2.5:14b-instruct-q4_K_M).
  eval_model: qwen3-30b-a3b-instruct
  # embed_model : appele via l'API OpenAI-compatible de LLM_URL — ce doit etre
  # un modele d'embedding servi par CE backend (ex. nomic-embed-text sous
  # Ollama), PAS un modele HuggingFace local type BAAI/bge-m3.
  embed_model: nomic-embed-text
  metrics:
    - faithfulness
    - answer_relevancy
    - context_recall
  thresholds:
    faithfulness: 0.8
    answer_relevancy: 0.75
    context_recall: 0.7
  dataset_path: evaluation/datasets/

# ─────────────────────────────────────────────────────────────────────────────
# Watcher — Surveillance automatique de fichiers et réindexation RAG
# ─────────────────────────────────────────────────────────────────────────────
watcher:
  enabled: true
  watched_paths:
    - path: /app/data
      recursive: true
      index_name: documents
  polling_interval: 5.0
  debounce_seconds: 3.0
  stability_checks: 3
  stability_interval: 2.0
  max_worker_threads: 1
  worker_poll_interval: 1.0
  reconcile_interval: 300
  reconcile_on_startup: true
  allowed_extensions: []
  excluded_dirs:
    - .git
    - __pycache__
    - .venv
    - node_modules
  excluded_extensions:
    - .tmp
    - .temp
  max_file_size_mb: 9999
  retry_max_attempts: 3
  retry_backoff_base: 60.0
  db_path: /app/backups/watcher/watcher.db
  api_port: 8090
  default_index_name: documents

# Pipeline itératif query2 (route /api/query2). Tous ces réglages sont
# relus à chaque requête : après édition, un simple reload-config depuis
# l'UI feedback les applique — sans rebuild ni redémarrage.
query2:
  # Termes propres au projet du corpus (nom du parc, de la commune, du
  # porteur...), exclus des requêtes d'inventaire forcé car présents
  # dans tous les titres et donc non discriminants. Liste YAML ou
  # chaîne séparée par virgules. Exemple pour la Panière du Fort :
  #   termes_structurants: [fort, paniere]
  termes_structurants: []
  # Garde-fou contradiction juge/générateur : si le juge de couverture
  # dit COUVERT mais que la réponse générée esquive la question, la
  # recherche B est forcée (mesuré sur Beaumont Sud, cas beaumont-09).
  garde_contradiction: true
  # Inventaire des titres du corpus dans le prompt de couverture :
  # un tome pertinent absent des passages force un verdict PARTIEL.
  catalogue_couverture: true
  # Profil « recherche approfondie » : appliqué quand la requête porte
  # deep_search=true (toggle UI existant). Même structure fixe en 4
  # étapes que le mode standard, mais entonnoir de retrieval élargi —
  # plus de passages remontés au prix de bruit et de latence. Les
  # valeurs ci-dessous sont les défauts du code : cette section ne sert
  # qu'à les surcharger. Chaque clé absente retombe sur son défaut.
  # Budget contexte : 30 passages complets en génération ~ 15-20k
  # tokens — vérifier la fenêtre du backend (num_ctx sous Ollama).
  deep:
    bm25_top_k: 80              # pool brut BM25 par recherche (standard : retrieval.bm25_top_k, 40)
    dense_top_k: 80             # pool brut dense par recherche (standard : 40)
    search_top_k: 200           # sortie de fusion RRF (standard : 100)
    fusion_top_k: 60            # pool soumis au reranker (standard : 30)
    rerank_top_n: 30            # passages conservés pour le LLM (standard : 15)
    coverage_max_passages: 20   # passages lus par le juge de couverture (standard : 12)
    coverage_max_queries: 4     # requêtes ciblées max (standard : 3)
    quota_par_requete: 6        # places garanties par requête ciblée (standard : 5)
    coverage_passage_chars: 1200  # caractères lus par passage au juge de
                                  # couverture (standard : 1200). Avec des
                                  # chunks >= 1024 tokens (~3800 car.),
                                  # porter à ~2400 avec coverage_max_passages: 16.
